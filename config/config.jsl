/***********************************************************
 * General Information
 *
 * Script Title    : Config
 * Version         : 4.0
 *
 * Description:
 * This script configurates global parameters
 *
 ************************************************************/
 
 /************************************************************/
/*                   ARCHITECTURE                           */
/************************************************************/
/*  1. VERSION                                              */
/*  2. PATHS                                                */
/*  	2.1 SAVING REPORTS PATH                             */
/*  	2.2 SERVERS LIST PATH                               */
/*  	2.3 USER GUIDE PATH                                 */
/*  	2.4 GUARDBAND PATH                                  */
/*  	2.5 USER  WORKFLOW PATH                             */
/*  	2.6 USER  SCREEN SIZE PATH                          */
/*  	2.7 USER  SCREEN SIZE PATH                          */
/*  3. HARD-CODED PARAMETERS                                */
/************************************************************/



// --------------------------------- 1. VERSION --------------------------------- //
 
/* Application version. If PROD, it's a version like: 1.0.0, 1.2.1 etc... If DEV, it's “(DEV)” followed by the date in yyyymmdd format. */
 Version = "2026@ V.4.0.0";

/* TLS certificate verification for the REST connections (1 = verify, default).
   Corporate CAs are honored via the OS certificate store. Only set to 0 for
   servers with self-signed certificates — with 0, a password sent over the
   connection could be intercepted by a man-in-the-middle on the network. */
int.TLSVerify = 1;
 
 
 // --------------------------------- 2. PATHS --------------------------------- // 

// =====  2.1  SAVING REPORTS PATH =====  //
str.PathReport = "$DOCUMENTS" || "\MES Data Retrieval\Reports\";
If( !Directory Exists( str.PathReport),
	Create Directory( str.PathReport );
);

// =====  2.1b  ADD-IN STATE/CACHE PATH =====  //
/* Add-in state files (window size, last server selected, guardband recall) must live in a
   location the current user can always write to. The add-in's own install folder (strPath)
   is not guaranteed to be writable (e.g. installed under Program Files, or run directly from
   a Downloads folder subject to Windows write restrictions), so these go under $DOCUMENTS
   instead, matching str.PathReport above. */
str.PathAppState = "$DOCUMENTS" || "\MES Data Retrieval\Config\";
If( !Directory Exists( str.PathAppState ),
	Create Directory( str.PathAppState );
);


// =====  2.2  SERVERS LIST PATH =====  //
//strPathServerlist = "$DOCUMENTS/MES_servers_list.xlsx";
strPathServerlist = "https://github.com/industrial-data/JMP-MES-connector/raw/refs/heads/version-4.0/MES_servers_list.xlsx";


// =====  2.3 USER GUIDE PATH =====  //
strPathHelpDoc = strPath || "doc/MES Data retrieval - User Guide.html";


// =====  2.4 GUARDBAND PATH =====  //
strPathGuardband = "$DOCUMENTS" || "\Guardband\";
str.path_guardband_recall = str.PathAppState || "guardband_selection_recall.txt";


// =====  2.5 WORKFLOW PATH =====  //
strWorkflowPath = "";


// =====  2.6 USER SCREEN SIZE PATH =====  //
PathWindowSize = str.PathAppState || "sizewindow.txt";

If(File Exists(PathWindowSize),
	Eval( Parse( Load Text File(PathWindowSize) )) ;
	,
	w = New Window("Get Window Size...");
	w << Maximize Window(1);
	WindowSize = w << Get Window Size();
	Try( Save Text File(PathWindowSize, "WindowSize = " || Char(WindowSize) ) );
	w << Close Window;
);

// =====  2.7 LAST SERVER SELECTED PATH =====  //
str.PathLastServerSelected = str.PathAppState || "LastServerSelected.txt";
If( File Exists( str.PathLastServerSelected ),
	Eval( Parse( Load Text File( str.PathLastServerSelected ) ) )
);

// --------------------------------- 3. HARD-CODED PARAMETERS --------------------------------- //


strTableVisibility = "invisible";   // Visibility of temporary tables
NRow_limit_IP21 = 1e6;				// Max nb of rows per tag for IP21 data extraction
NRow_limit_PI = 1e6;                // Max nb of rows per tag for PI data extraction
NRow_limit_preview = 1e6;           // Max nb of rows per tag for preview
max_n_attempts = 10;				// Maximal number of attempts 

// Possible tag types.
// v3/v4: the REST transports return FULL type names (PI Web API point types
// like Float32/Int16/Digital/String, AF attribute types like Double/Boolean),
// while the OLEDB era used single letters (R/I/D/S) — both are listed so
// labels and type checks work for old and new tables alike.
IP21Types = {"Analog", "Discrete", "Text"};
PITypes = {"R", "I", "D", "S",
	"Float16", "Float32", "Float64", "Int16", "Int32", "Int64", "Digital", "String", "Timestamp",
	"Double", "Single", "Boolean", "EnumerationValue"};
AllTypes = List();
Insert Into( AllTypes, IP21Types );
Insert Into( AllTypes, PITypes );
IP21NumTags = {"Analog", "AI"};
IP21TextTags = {"Discrete", "Text", "DI"};
PINumTags = {"R", "I", "Float16", "Float32", "Float64", "Int16", "Int32", "Int64", "Double", "Single"};
PITextTags = {"D", "S", "Digital", "String", "Boolean", "EnumerationValue"};
PreviewTags = {"Discrete", "Text", "DI", "D", "S", "I",
	"Digital", "String", "Boolean", "EnumerationValue", "Timestamp"};


/* List of numerical comparator for filters */
lst.Comparators = {"=", ">", "<", ">=", "<=",  "In", "Not In", "Like", "Not Like"};
CompNum = {">", "<", ">=", "<="};

/* List of required columns for report*/
lst.RequiredReportColumns = {"MES", "SERVER EXTENSION", "SERVER SHORT NAME", "SERVER TYPE", "SERVER EDITED",
"TAGS", "EXTRACTION METHOD", "PERIOD VALUE", "PERIOD UNIT", "START DATE", "END DATE",
"FILTERS", "CONDITION FILTERS", "SUMMARY OPTION", "WORKFLOW OPTION"};
 