/***********************************************************
 * General Information
 *
 * Script Title    : Ressources REST (v3.0)
 *
 * Description:
 * Bridge between JSL and the Python REST extraction layer
 * (include/Ressources/python/mes_connector — see its README.md).
 *
 * v3.0 architecture — REST is the ONLY transport (OLEDB/ODBC were removed):
 *  - IP21 : the proven SQLplus queries (Ressources_SQL.jsl) are POSTed to
 *           Aspen's Process Data REST service (AtProcessDataREST.dll/SQL).
 *  - PI   : native PI Web API (search / interpolated / recorded / summary),
 *           ported from the validated notebook in Ressources/python.
 *
 * Server list requirements (MES_servers_list.xlsx):
 *  - WebAPI_URL : MANDATORY.
 *                 PI  -> https://<host>/piwebapi
 *                 IP21-> http://<host>/ProcessData/AtProcessDataREST.dll
 *                 (scheme/trailing-slash/missing-path tolerant: the Python
 *                 layer's normalize_base_url() completes partial addresses,
 *                 e.g. a bare IP21 host gets /ProcessData/AtProcessDataREST.dll
 *                 appended — the URL must end up pointing at that .dll)
 *  - server     : PI  -> Data Archive server name (as in PI System Explorer)
 *                 IP21-> ADSA data source name (usually the IP21 host name)
 *
 * Auth: SSO first (Windows SSPI / Kerberos); on 401 the Python layer raises
 * AuthRequired and f_REST_PyCall shows a JSL login dialog, stores the
 * credentials in Python memory (never on disk) and retries once.
 ************************************************************/


/****************************************************
*  I. STATE & AVAILABILITY
******************************************************/

REST_PY_INITIALIZED = 0;
If( Is Empty( WebAPIURL ), WebAPIURL = "" );
If( Is Empty( DAServer ), DAServer = "" );        // = the mandatory "server" field (PI DA / IP21 data source)
If( Is Empty( PIAFServer ), PIAFServer = "" );    // optional, PI only — reserved for the future AF attribute search
REST_ChunkSize = 5;                                // tags per Python call; matches the PI worker pool, drives the progress bar

/* REST is the only transport: a server without a WebAPI URL cannot be queried */
f_REST_CheckConfigured = Function( {},
	If( Trim( Char( WebAPIURL ) ) == "",
		f_DialogError( "No WebAPI URL configured for this server. Add it in the server list or in 'Edit server address'." )
	);
	1;
);


/****************************************************
*  II. PYTHON SESSION
******************************************************/

/*
    f_REST_InitPython Function

    Prepares JMP's embedded Python (once per JMP session):
      1. Locates the mes_connector package folder inside the add-in
         (dev fallback: the current default directory when the add-in
         path variable is not set).
      2. Adds it to sys.path with the path EMBEDDED in the python source
         (forward slashes — valid on Windows too). We deliberately do not
         rely on Python Send() for this critical step.
      3. Imports mes_connector inside python and reports the REAL outcome
         back ("OK ..." or "IMPORT_ERROR: ..."), which goes to the JMP log.
      4. If a core dependency is missing (JMP's python is an ISOLATED
         environment with its own site-packages — a fresh JMP install has
         no requests/pandas/numpy), installs the required set on demand via
         Python Install Packages and retries. Independently of that, any
         missing OPTIONAL package is installed on every init: the Kerberos
         SSO library (requests-negotiate-sspi on Windows, requests-kerberos
         elsewhere — SSO is the default login), keyring, truststore and
         requests-ntlm. If the SSO install fails, the login dialog covers
         auth.
      5. Round-trip-tests Python Send/Get, since every later bridge call
         relies on that mechanism.
*/
f_REST_InitPython = Function( {},

	If( REST_PY_INITIALIZED == 1, Return( 1 ) );

	// v3.0 needs JMP's modern embedded Python (DataFrame <-> data table)
	If( Num( Word( 1, Char( JMP Version() ), "." ) ) < 18,
		f_DialogError( "This add-in version requires JMP 18 or later (embedded Python). Detected: " || Char( JMP Version() ) )
	);

	// --- 1) Locate the package folder -----------------------------------
	// strPath is resolved and validated at launch (LAUNCH_APPLICATION.jsl),
	// covering both the installed add-in and dev runs from the repository.
	str.pkg_jmp_path = strPath || "include/Ressources/python";
	If( !Try( Directory Exists( str.pkg_jmp_path ), 0 ),
		f_DialogError(
			"mes_connector python package not found at: " || Char( str.pkg_jmp_path ) ||
			". The v3.0 add-in files are incomplete - reinstall the add-in."
		)
	);
	If( Host is( "Windows" ),
		// Forward slashes are valid path separators for python on Windows and
		// avoid any backslash-escaping issues inside the python source string
		rest_pkg_path = Substitute( Convert File Path( str.pkg_jmp_path, windows ), "\!\", "/" ),
		rest_pkg_path = Convert File Path( str.pkg_jmp_path, posix )
	);

	Python Init();

	// --- 2+3) sys.path + import check, path embedded in the source ------
	If( Is Empty( int.TLSVerify ), int.TLSVerify = 1 );
	str.init_code = Eval Insert( "\[
import sys
rest_status = ""
rest_optdeps = ""
_pkg = "^rest_pkg_path^"
if _pkg not in sys.path:
    sys.path.insert(0, _pkg)
try:
    import mes_connector
    mes_connector.configure_tls(bool(^int.TLSVerify^))
    rest_status = "OK " + mes_connector.__version__ + " | python " + sys.version.split()[0] + " | " + _pkg
    _sso_mods = ("requests_negotiate_sspi", "requests_kerberos") if sys.platform == "win32" else ("requests_kerberos",)
    for _m in _sso_mods:
        try:
            __import__(_m)
            break
        except ImportError:
            pass
    else:
        rest_optdeps += _sso_mods[0] + " "
    for _opt in ("keyring", "truststore", "requests_ntlm"):
        try:
            __import__(_opt)
        except ImportError:
            rest_optdeps += _opt + " "
except Exception as _ex:
    rest_status = "IMPORT_ERROR: " + repr(_ex) + " | pkg=" + _pkg
]\" );
	Python Submit( str.init_code );
	rest_status = Python Get( rest_status );
	f_Log( "INFO", "Python init - " || Char( rest_status ), "REST" );

	// --- 4) Missing dependency? install into JMP's site-packages --------
	// ANY missing core module surfaces as "No module named '...'" — pandas
	// and numpy are just as mandatory as requests (mes_connector imports
	// them at the top level). Installing the three roots lets pip pull the
	// whole dependency tree (urllib3, dateutil, ...) in one shot.
	If( Contains( Char( rest_status ), "No module named" ),
		f_Log( "WARNING", "JMP's python environment lacks core packages (" || Char( rest_status ) || ") - installing requests, pandas, numpy now (needs internet/proxy access)...", "REST" );
		Try( Python Install Packages( "requests pandas numpy" ) );
		Python Submit( str.init_code );
		rest_status = Python Get( rest_status );
		f_Log( "INFO", "Python init (after install) - " || Char( rest_status ), "REST" );
	);

	If( !Starts With( Char( rest_status ), "OK" ),
		f_DialogError(
			"Python setup failed: " || Char( rest_status ) ||
			If( Contains( Char( rest_status ), "No module named" ),
				"\!N\!NJMP could not install the required python packages (requests, pandas, numpy). Check internet/proxy access and retry - the JMP log shows the pip output.",
				""
			)
		)
	);

	// Optional packages, installed whenever missing (NOT only on a fresh
	// python environment — that was the v3.0 bug that left machines with
	// pre-existing core packages without SSO forever):
	//  - the Kerberos SSO library, requests-negotiate-sspi on Windows /
	//    requests-kerberos elsewhere. SSO is the DEFAULT login: without it
	//    every user gets the password dialog.
	//  - keyring (remember passwords in the OS credential vault) and
	//    truststore (validate TLS against the OS certificate store, so
	//    corporate CAs work) and requests-ntlm (explicit-credential NTLM).
	// Everything still degrades gracefully without them (login dialog each
	// session / certifi CA bundle).
	rest_optdeps = Trim( Try( Char( Python Get( rest_optdeps ) ), "" ) );
	If( rest_optdeps != "",
		// pip names = module names with hyphens; ONE pip call per package so a
		// single failing build cannot block the others
		lst.opt_pips = Words( Substitute( rest_optdeps, "_", "-" ) );
		f_Log( "INFO", "Installing missing python packages: " || Concat Items( lst.opt_pips, " " ), "REST" );
		For( int.i_pip = 1, int.i_pip <= N Items( lst.opt_pips ), int.i_pip++,
			Try( Python Install Packages( lst.opt_pips[int.i_pip] ) )
		);
		Python Submit( str.init_code );  // re-run the import check to report the real outcome
		rest_optdeps = Trim( Try( Char( Python Get( rest_optdeps ) ), "" ) );
		// Windows fallback: when requests-negotiate-sspi cannot be installed
		// (pip build/proxy trouble), requests-kerberos delivers the same silent
		// SSO through SSPI (auth.py tries both libraries)
		If( Contains( rest_optdeps, "requests_negotiate_sspi" ),
			f_Log( "INFO", "requests-negotiate-sspi could not be installed - trying requests-kerberos instead (same Windows SSO).", "REST" );
			Try( Python Install Packages( "requests-kerberos" ) );
			Python Submit( str.init_code );
			rest_optdeps = Trim( Try( Char( Python Get( rest_optdeps ) ), "" ) );
		);
		If( rest_optdeps != "",
			f_Log( "WARNING", "Optional python packages still missing after install: " || rest_optdeps || " - Kerberos single sign-on stays unavailable if the SSO library is among them (the login dialog still works). Check internet/proxy access; pip output is in the JMP log.", "REST" ),
			f_Log( "INFO", "Optional python packages installed - Kerberos SSO is available.", "REST" )
		);
	);

	// --- 5) Verify the Python Send/Get mechanism the bridge relies on ---
	rest_probe = "ping";
	Python Send( rest_probe );
	If( Char( Try( Python Get( rest_probe ), "" ) ) != "ping",
		f_DialogError( "JMP's Python Send/Get round-trip failed - cannot pass parameters to the REST layer. Check your JMP python configuration (File > Preferences > Python)." )
	);

	REST_PY_INITIALIZED = 1;
	f_Log( "INFO", "Python REST layer initialized - " || rest_pkg_path, "REST" );
);


/* Modal login dialog shown when the server answers 401 (SSO not accepted).
   Returns {user, password, remember}; user == "" means the user cancelled.
   With remember = 1 the Python layer stores the credentials in the OS
   credential vault (Windows Credential Manager / macOS Keychain) so the
   user never types them again on this machine. */
f_REST_Login = Function( {rest_host},

	str.vault_name = If( Host is( "Windows" ), "Windows Credential Manager", "macOS Keychain" );
	str.remember_label = "Remember on this computer (" || str.vault_name || ")";

	// The values are captured in the OK button script (NOT via the modal's
	// Return Result, which is unreliable for password-style boxes and made
	// the typed password arrive empty -> the dialog kept re-asking).
	str.login_user = "";
	str.login_pwd = "";
	int.login_remember = 0;

	login_result = New Window( "Server login",
		<<Modal,
		V List Box(
			Border Box( Left( 10 ), Right( 10 ), Top( 10 ),
				V List Box(
					Text Box( "The server '" || Char( rest_host ) || "' requires a login." ),
					Text Box( "For domain accounts use DOMAIN\!\user or user@domain." )
				)
			),
			Spacer Box( Size( 10, 10 ) ),
			Border Box( Left( 10 ),
				Lineup Box( N Col( 2 ),
					Text Box( "Username:" ), teb_rest_user = Text Edit Box( "", <<Set Width( 220 ) ),
					Text Box( "Password:" ), teb_rest_pwd = Text Edit Box( "", <<Set Width( 220 ), <<Password Style( 1 ) )
				)
			),
			Border Box( Left( 10 ), Top( 6 ),
				chk_rest_remember = Check Box( Eval List( {str.remember_label} ) )
			),
			Spacer Box( Size( 10, 10 ) ),
			H Center Box( H List Box(
				Button Box( "OK",
					str.login_user = teb_rest_user << Get Text;
					str.login_pwd = teb_rest_pwd << Get Text;
					int.login_remember = Try( chk_rest_remember << Get( 1 ), 0 );
					If( Is Missing( int.login_remember ), int.login_remember = 0 );
				),
				Button Box( "Cancel" )
			) )
		)
	);
	If( login_result["Button"] == 1,
		Eval List( {str.login_user, str.login_pwd, int.login_remember} ),
		{"", "", 0}
	);
);


/*
    f_REST_PyCall Function

    Core wrapper for every JSL -> Python call.

    @param py_body: python statements that must assign a pandas DataFrame to
                    `rest_df`. The mes_connector package is imported as `mc`.
                    Input values must have been passed beforehand with
                    Python Send( rest_xxx ).

    Behavior: runs the code, converts AuthRequired into a login dialog +
    one retry, converts any other python exception into a JSL Throw (so the
    caller's Try() can show the appropriate error dialog).

    f_REST_PyExec runs the code without fetching a table back (used for the
    chunked extraction steps); f_REST_PyCall additionally returns rest_df as
    a JMP data table.
*/
f_REST_PyExec = Function( {py_body},

	f_REST_InitPython();

	// Indent the body so it sits inside the try: block
	py_full = "\[
import pandas as pd
rest_err = ""
rest_df = pd.DataFrame()
try:
    from mes_connector.auth import AuthRequired
except Exception:
    class AuthRequired(Exception):
        pass
try:
    import mes_connector as mc
    ]\" || Substitute( py_body, "\!n", "\!n    " ) || "\[

except AuthRequired as _ex:
    rest_err = "AUTH:" + str(_ex)
except Exception as _ex:
    rest_err = "ERROR:" + str(_ex)
]\";

	rest_done = 0;
	rest_try = 0;
	While( And( rest_done == 0, rest_try <= 2 ),
		rest_try++;
		Python Submit( py_full );
		rest_err = Python Get( rest_err );
		If( Starts With( Char( rest_err ), "AUTH:" ),
			// 401 -> ask for credentials and retry the same call. With
			// "remember" checked, the Python layer stores them in the OS
			// credential vault (never on disk in clear text).
			rest_host = Substr( rest_err, 6 );
			{rest_user, rest_pwd, rest_remember} = f_REST_Login( rest_host );
			If( rest_user == "",
				rest_done = 1
			,
				Python Send( rest_host );
				Python Send( rest_user );
				Python Send( rest_pwd );
				Python Send( rest_remember );
				Python Submit( "\[
import mes_connector as mc
mc.set_credentials(rest_host, rest_user, rest_pwd, bool(rest_remember))
rest_user = rest_pwd = None  # do not keep the secret in the python globals
]\" );
				rest_pwd = "";  // nor in the JSL namespace
			);
		,
			rest_done = 1
		);
	);

	If( Char( rest_err ) != "",
		f_Log( "ERROR", "REST call failed - " || Char( rest_err ), "REST" );
		Throw( "REST: " || Char( rest_err ) );
	);

	Return( 1 );
);

f_REST_PyCall = Function( {py_body},
	f_REST_PyExec( py_body );
	Return( Python Get( rest_df ) );
);


/****************************************************
*  III. HIGH-LEVEL CALLS (used by Ressources_SQL.jsl dispatchers)
******************************************************/

/* Tag search. Returns a table with columns tagnames/descriptions/units/type
   (identical shape to the legacy SQL search — the GUI depends on it). */
f_REST_FindTags = Function( {TagName, TagDescription},

	rest_base = Char( WebAPIURL );
	rest_da = Char( DAServer );
	Python Send( rest_base );
	Python Send( rest_da );

	If( ServerType == "IP21",
		// IP21: reuse the UNCHANGED legacy search SQL, wrapped in REST
		rest_sql = Substitute( __SQL_FINDTAGS_IP21, "VAR_TAGNAME", TagName, "VAR_DESCRIPTION", TagDescription );
		f_Log( "INFO", "<SQL via REST>  \!n\!n" || rest_sql || "\!n\!n", "REST" );
		Python Send( rest_sql );
		dt_rest = f_REST_PyCall( "rest_df = mc.ip21_sql(rest_base, rest_da, rest_sql)" );
	,
		// PI: native PI Web API point search (af_server reserved for the
		// future AF attribute search with collapsible element hierarchy)
		rest_name = Char( TagName );
		rest_desc = Char( TagDescription );
		rest_af = Char( PIAFServer );
		Python Send( rest_name );
		Python Send( rest_desc );
		Python Send( rest_af );
		dt_rest = f_REST_PyCall( "rest_df = mc.search_tags('PI', rest_base, rest_da, rest_name, rest_desc, rest_af)" );
	);

	dt_rest << Set Name( "f_REST_FINDTAGS Results" );
	dt_rest << Show Window( 0 );
	Return( dt_rest );
);


/* Run any SQLplus query on IP21 through the REST wrapper (v3.0 default
   transport — same SQL text as the ODBC path). Returns the result table. */
f_IP21_REST_SQL = Function( {SQL_query},
	rest_base = Char( WebAPIURL );
	rest_da = Char( DAServer );
	rest_sql = SQL_query;
	Python Send( rest_base );
	Python Send( rest_da );
	Python Send( rest_sql );
	dt_rest = f_REST_PyCall( "rest_df = mc.ip21_sql(rest_base, rest_da, rest_sql)" );
	dt_rest << Show Window( 0 );
	Return( dt_rest );
);


/* Tag type for one PI tag via the Web API (exact-name point search). */
f_REST_PI_TagType = Function( {Tag},
	rest_base = Char( WebAPIURL );
	rest_da = Char( DAServer );
	rest_name = Char( Tag );
	Python Send( rest_base );
	Python Send( rest_da );
	Python Send( rest_name );
	dt_rest = f_REST_PyCall(
		"rest_df = mc.search_tags('PI', rest_base, rest_da, rest_name, '')\!nrest_df = rest_df[rest_df['tagnames'] == rest_name].head(1)"
	);
	If( N Rows( dt_rest ) == 0,
		Close( dt_rest, nosave );
		f_DialogError( "No tagtype found" );
	);
	TagTypeRslt = Column( dt_rest, "type" )[1];
	Close( dt_rest, nosave );
	Return( TagTypeRslt );
);


/* Distinct values of one PI tag over the selected window (used by Preview).
   NOTE: registered filters are not applied in the REST preview (they are in
   the final extraction); the preview's purpose is to list possible values. */
f_REST_PI_Preview = Function( {TagName, StartFormat, EndFormat},
	rest_base = Char( WebAPIURL );
	rest_da = Char( DAServer );
	rest_name = Char( TagName );
	rest_start = Char( StartFormat );
	rest_end = Char( EndFormat );
	rest_interval = NewPeriodNumValue_s;
	Python Send( rest_base );
	Python Send( rest_da );
	Python Send( rest_name );
	Python Send( rest_start );
	Python Send( rest_end );
	Python Send( rest_interval );
	dt_rest = f_REST_PyCall(
		"rest_df = mc.pi_distinct_values(rest_base, rest_da, rest_name, rest_start, rest_end, int(rest_interval))"
	);
	dt_rest << Set Name( "f_SQL_PREVIEW Results" );
	Return( dt_rest );
);


/****************************************************
*  IV. FILTER SERIALIZATION
******************************************************/

/* Escape a string for inclusion inside a JSON string literal */
f_JSON_Escape = Function( {str_in},
	str_out = Substitute( Char( str_in ), "\!\", "\!\\!\" );
	str_out = Substitute( str_out, "\!"", "\!\\!"" );
	Return( str_out );
);

/*
    f_Filters_ToJSON Function

    Serializes the GUI's Filters_AA structure to the JSON contract expected by
    mes_connector.filters.parse_filters_json (see filters.py for the format).
    Structure of one Filters_AA entry (inherited from v2.x):
      Filter[1] = label, or {label1, label2} when two filters were nested
      Filter[2] = tag type(s)
      Filter[3] = {comp1, value1} or {comp1, value1, comp2, value2}
*/
f_Filters_ToJSON = Function( {Filters_AA, Condition},

	Filters_Keys = Filters_AA << Get Keys;
	If( N Items( Filters_Keys ) == 0, Return( "" ) );

	lst_json = List();
	For( i = 1, i <= N Items( Filters_Keys ), i++,
		Filter = Filters_AA[Filters_Keys[i]];

		If( Is List( Filter[1] ),
			// nested pair: two tags, two comparisons
			Tag1 = f_Remove_UnitDescription( Filter[1][1], TagSelect_AA );
			Tag2 = f_Remove_UnitDescription( Filter[1][2], TagSelect_AA );
			str_tags = "[\!"" || f_JSON_Escape( Tag1 ) || "\!",\!"" || f_JSON_Escape( Tag2 ) || "\!"]";
			str_comps = "[\!"" || f_JSON_Escape( Filter[3][1] ) || "\!",\!"" || f_JSON_Escape( Filter[3][3] ) || "\!"]";
			str_vals = "[\!"" || f_JSON_Escape( Filter[3][2] ) || "\!",\!"" || f_JSON_Escape( Filter[3][4] ) || "\!"]";
		,
			Tag1 = f_Remove_UnitDescription( Filter[1], TagSelect_AA );
			str_tags = "[\!"" || f_JSON_Escape( Tag1 ) || "\!"]";
			str_comps = "[\!"" || f_JSON_Escape( Filter[3][1] ) || "\!"]";
			str_vals = "[\!"" || f_JSON_Escape( Filter[3][2] ) || "\!"]";
		);

		Insert Into( lst_json, "{\!"tags\!":" || str_tags || ",\!"comps\!":" || str_comps || ",\!"values\!":" || str_vals || "}" );
	);

	Return( "{\!"condition\!":\!"" || Char( Condition ) || "\!",\!"filters\!":[" || Concat Items( lst_json, "," ) || "]}" );
);


/****************************************************
*  V. PI EXTRACTION VIA PI WEB API
******************************************************/

/*
    f_RunExtraction_PI_REST Function

    Full PI extraction over the PI Web API. Replaces the per-tag SQL loop:
    the Python layer extracts all tags in parallel (max 5 workers), retries
    failures, applies the registered filters (server-side filterExpression
    when possible, pandas otherwise) and returns ONE wide table:
        TS (server-local), TS_UTC, one column per selected tag label.

    Sets the same globals as the legacy path so the formatting section of
    EXPR_DATA_EXTRACTION works unchanged: tblAllTags, TagExtract_AA, TagType_AA.
*/
f_RunExtraction_PI_REST = Function( {lstTags, StartFormat, EndFormat, Filters_AA},

	section = "DATA EXTRACTION (PI WEB API)";
	f_Log( "INFO", "START PI Web API extraction - " || Char( N Items( lstTags ) ) || " tags.", section );

	// Labels shown in the GUI (tag + description + unit + {type}) become the
	// output column names, like in the legacy pipeline. In the main GUI the
	// selection list (lstTagNames_UnitDesc) is available; when called from a
	// saved table's Update/Refresh or Add-tags script it is not, so derive
	// the labels from TagSelect_AA (label -> tagname), falling back to the
	// bare tag name.
	use_selection = Try( N Items( lstTagNames_UnitDesc ) == N Items( lstTags ), 0 );
	If( use_selection,
		lstLabels = lstTagNames_UnitDesc
	,
		lstLabels = List();
		ts_keys = TagSelect_AA << Get Keys;
		ts_vals = TagSelect_AA << Get Values;
		For( i = 1, i <= N Items( lstTags ), i++,
			ind = As List( Loc( ts_vals, lstTags[i] ) );
			Insert Into( lstLabels,
				If( N Items( ind ) > 0, ts_keys[ind[1]], Char( lstTags[i] ) )
			);
		);
	);

	TagExtract_AA = Associative Array();
	TagType_AA = Associative Array();
	For( i = 1, i <= N Items( lstTags ), i++,
		TagExtract_AA[lstLabels[i]] = lstTags[i];
		Try( TagType_AA[lstLabels[i]] = Word( 2, lstLabels[i], "{}" ) );
	);

	rest_base = Char( WebAPIURL );
	rest_da = Char( DAServer );
	rest_method = Char( ExtractionMethod );
	rest_start = Char( StartFormat );
	rest_end = Char( EndFormat );
	rest_interval = NewPeriodNumValue_s;
	rest_filters = f_Filters_ToJSON( Filters_AA, Condition );

	f_Log( "INFO",
		"PI Web API - base URL " || rest_base || " / DA server " || rest_da || " / method " || rest_method
		 || " / window " || rest_start || " -> " || rest_end || " / interval " || Char( rest_interval ) || "s"
		 || " (request URLs are echoed below by the Python layer)", section );

	Python Send( rest_base );
	Python Send( rest_da );
	Python Send( rest_method );
	Python Send( rest_start );
	Python Send( rest_end );
	Python Send( rest_interval );
	Python Send( rest_filters );

	// Open an extraction session on the Python side (computes the shared
	// filterExpression once), then feed it chunks of tags so the existing
	// progress bar can advance between Python calls.
	f_REST_PyExec(
		"mc.pi_extract_begin(rest_base, rest_da, rest_method, rest_start, rest_end, int(rest_interval), rest_filters)\!nrest_df = __import__('pandas').DataFrame()"
	);

	NTags = N Items( lstTags );
	progress:init( NTags, WindowSize );

	// Any chunk failure must close the progress window before propagating
	Try(

	i_done = 0;
	While( i_done < NTags,
		i_hi = Min( i_done + REST_ChunkSize, NTags );

		strInfo = "Extracting (PI Web API): " || Char( i_hi ) || " / " || Char( NTags ) || " - " || Char( lstTags[i_done + 1] );
		f_Log( "INFO", strInfo, section );
		progress:set( i_hi, strInfo );
		Try(
			bttn_Extraction << Set Button Name( strInfo );
			bttn_Extraction2 << Set Button Name( strInfo );
		);

		rest_tags = lstTags[Index( i_done + 1, i_hi )];
		rest_labels = lstLabels[Index( i_done + 1, i_hi )];
		Python Send( rest_tags );
		Python Send( rest_labels );
		f_REST_PyExec( "mc.pi_extract_chunk(list(rest_tags), list(rest_labels))\!nrest_df = __import__('pandas').DataFrame()" );

		i_done = i_hi;
	);

	tblAllTags = f_REST_PyCall( "rest_df = mc.pi_extract_end()" );

	, // On error: close the progress bar, then rethrow to the caller's error handling
		progress:term();
		Throw( "REST: PI Web API extraction failed (see log)" );
	);
	progress:term();

	f_Log( "INFO", "END PI Web API extraction - " || Char( N Rows( tblAllTags ) ) || " rows.", section );
	Return( tblAllTags );
);
